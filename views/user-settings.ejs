<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('components/header'); -%>
</head>
<body class="bg-antique-white">
    <% if (message && message.length > 0) { %>
        <div class="fixed top-10 left-[15%] md:left-[22rem] z-50">
            <div id="alert-border-3" class="flex items-center p-4 mb-4 text-green-800 border-t-4 border-green-300 bg-green-50 dark:text-green-400 dark:bg-gray-800 dark:border-green-800" role="alert">
                <svg class="flex-shrink-0 w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
                </svg>
                <div class="ms-3 text-sm font-medium mr-4">
                <%= message %>
                </div>
                <button id="close" type="button" class="ms-auto -mx-1.5 -my-1.5 bg-green-50 text-green-500 rounded-lg focus:ring-2 focus:ring-green-400 p-1.5 hover:bg-green-200 inline-flex items-center justify-center h-8 w-8 dark:bg-gray-800 dark:text-green-400 dark:hover:bg-gray-700"  data-dismiss-target="#alert-border-3" aria-label="Close">
                <span class="sr-only">Dismiss</span>
                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
                </button>
            </div>
        </div>
    <% } %>

    <div class="fixed top-3 right-4 md:top-6 md:right-7 bg-charcoal h-10 md:h-12 w-32 md:w-44 rounded-lg flex items-center justify-center z-20">
        <p class="text-xl md:text-2xl text-antique-white ">Lexiconlab</p>
    </div>

    <!-- Burger -->
    <div id="hamburger" class="bg-charcoal h-10 w-16 rounded-md md:hidden fixed top-3 left-4 z-20">

    </div>

    <div class="w-full grid grid-cols-10">
        <div id="sidebar" class="hidden w-full h-screen md:block md:col-span-2 z-40">
            <div id="cross" class="bg-antique-white h-10 w-16 rounded-md md:hidden fixed top-3 left-4 z-20">

            </div>
            <!-- Sidebar -->
            <div class="fixed w-80 h-screen bg-charcoal flex flex-col items-center justify-between transition-all">
                <div class="w-full px-4 mt-8 h-fit">
                    <div class="w-full flex flex-col items-center">
                        <img src="<%= user.profile_photo %>" alt="" class="border-2 rounded-full w-32  h-32">
                        <p class="mt-2 text-white font-bold text-lg"><%= user.username  %></p>
                        <p class="text-white text-md opacity-60 -mt-1"><%= user.name %></p>
                    </div>

                    <div class="mt-6 w-full h-fit flex flex-col items-center justify-between">
                        <a href="/dictionary" class="mt-1 w-full h-10 flex items-center justify-start border-b-2 border-cerise">
                            <div class="h-4 w-4 mb-2 bg-cerise"></div>
                            <p class="ml-4 mb-2 text-lg text-white">Dictionary</p>
                        </a>

                        <a href="/dictionary" class="mt-5 w-full h-10 flex items-center justify-start border-b-2 border-cerise">
                            <div class="h-4 w-4 mb-2 bg-cerise"></div>
                            <p class="ml-4 mb-2 text-lg text-white">Bookmarks</p>
                        </a>

                        <a href="/dictionary" class="mt-5 w-full h-10 flex items-center justify-start border-b-2 border-cerise">
                            <div class="h-4 w-4 mb-2 bg-cerise"></div>
                            <p class="ml-4 mb-2 text-lg text-white">Search History</p>
                        </a>

                        <a href="#" class="mt-5 w-full h-10 flex items-center justify-start border-b-2 border-antique-white">
                            <div class="h-4 w-4 mb-2 bg-antique-white"></div>
                            <p class="ml-4 mb-2 text-lg text-antique-white">User Settings</p>
                        </a>
                    </div>
                </div>

                <div class="w-full h-fit flex items-center justify-end border-t-2 border-cerise p-4">
                    <div class="my-2 flex items-center justify-end">
                        <form action="/logout" method="POST">
                            <button type="submit" class="ml-4 flex w-fit justify-center rounded-md bg-cerise px-8 py-1.5 text-sm font-semibold leading-6 shadow-sm hover:bg-opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cerise">LOGOUT</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-span-10 md:col-span-8">
            <div class="relative flex flex-col items-center w-full px-4 md:px-0">
                <!-- Profile Photo -->
                <div class="bg-white w-full md:w-[55rem] shadow-xl rounded-xl mt-16 md:mt-20">
                    <div class="w-full flex min-h-full flex-col justify-center px-0 py-6">            
                        <div class="mt-4 sm:mx-auto sm:w-full px-10">
                        <form class="space-y-6 mb-4" action="/profile_photo" method="POST" enctype="multipart/form-data">
                            <div class="w-full h-fit flex items-center justify-center">
                                <div class="w-28 h-28 rounded-full border-2">
                                    <% if(user) { %>
                                    <img id="image" src="<%= user.profile_photo %>" alt="" class="rounded-full w-full  h-full">
                                    <% } else { %>
                                    <img id="image" src="/assets/bubbles.svg" alt="" class="rounded-full w-full  h-full">
                                    <% } %>
        
                                </div>
                            </div>
                            <div>
                                <label for="photo" class="block text-sm font-medium leading-6 text-gray-900">Profile Photo</label>
                                <div class="mt-2">
                                    <input id="photo" name="photo" type="file" autocomplete="photo" value="" required onchange="show()" class="block w-full rounded-md border-0 pl-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-0 focus:outline-cerise sm:text-sm sm:leading-6">
                                </div>
                            </div>
        
                            <div class="h-[0.075rem] w-full bg-gray-200"></div>
                            <div class="mt-8 flex items-center justify-end">
                                <button type="submit" class="mt-4 ml-4 flex w-fit justify-center rounded-md bg-cerise px-8 py-1.5 text-sm font-semibold leading-6 shadow-sm hover:bg-opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cerise">SAVE</button>
                            </div>
                        </form>
                        </div>
                    </div>
                </div>
                <!-- End of profile photo section -->
        
                <!-- User name -->
                <div class="bg-white w-full md:w-[55rem] shadow-xl rounded-xl mt-8 md:mt-20">
                    <div class="w-full flex min-h-full flex-col justify-center px-0 py-6">            
                        <div class="mt-4 sm:mx-auto sm:w-full px-10">
                            <form class="space-y-6 mb-6" action="/update_name" method="POST">
                                <div>
                                    <label for="username" class="block text-sm font-medium leading-6 text-gray-900">User Name</label>
                                    <div class="mt-2">
                                        <input id="username" name="username" type="text" autocomplete="username" value="<%= user.username %>" required class="block w-full rounded-md border-0 py-1.5 pl-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-0 focus:outline-naples-yellow sm:text-sm sm:leading-6">
                                    </div>
                                </div>
                                <div>
                                    <label for="name" class="block text-sm font-medium leading-6 text-gray-900">Actual Name</label>
                                    <div class="mt-2">
                                        <input id="name" name="name" type="text" autocomplete="name" value="<%= user.name %>" required class="block w-full rounded-md border-0 py-1.5 pl-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-0 focus:outline-naples-yellow  sm:text-sm sm:leading-6">
                                    </div>
                                </div>
                                <div class="h-[0.075rem] w-full bg-gray-200"></div>
                                <div class="mt-8 flex items-center justify-end">
                                    <button type="submit" class="mt-4 ml-4 flex w-fit justify-center rounded-md bg-cerise px-8 py-1.5 text-sm font-semibold leading-6 shadow-sm hover:bg-opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cerise">SAVE</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- User name -->
        
                <!-- Password Update -->
                <div class="bg-white w-full md:w-[55rem] shadow-xl rounded-xl mt-8 md:mt-20">
                    <div class="w-full flex min-h-full flex-col justify-center px-0 py-6">            
                        <div class="mt-4 sm:mx-auto sm:w-full px-10">
                            <form class="space-y-6 mb-6" action="/update_password" method="POST">
                                <div>
                                    <label for="current_password" class="block text-sm font-medium leading-6 text-gray-900">Current Password</label>
                                    <div class="mt-2">
                                        <input id="current_password" name="current_password" type="password" value="" autocomplete="" required class="block w-full rounded-md border-0 py-1.5 pl-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-0 focus:outline-naples-yellow sm:text-sm sm:leading-6">
                                    </div>
                                </div>
                                <div>
                                    <label for="New Password" class="block text-sm font-medium leading-6 text-gray-900">New Password</label>
                                    <div class="mt-2">
                                        <input id="new_password" name="new_password" type="password" value="" autocomplete="" required class="block w-full rounded-md border-0 py-1.5 pl-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-0 focus:outline-naples-yellow  sm:text-sm sm:leading-6">
                                    </div>
                                </div>
                                <div>
                                    <label for="confirm_password" class="block text-sm font-medium leading-6 text-gray-900">Confirm Password</label>
                                    <div class="mt-2">
                                        <input id="confirm_password" name="confirm_password" type="password" value="" autocomplete="" required class="block w-full rounded-md border-0 py-1.5 pl-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-0 focus:outline-naples-yellow  sm:text-sm sm:leading-6">
                                    </div>
                                </div>
                                <div class="h-[0.075rem] w-full bg-gray-200"></div>
                                <div class="mt-8 flex items-center justify-end">
                                    <button type="submit" class="mt-4 ml-4 flex w-fit justify-center rounded-md bg-cerise px-8 py-1.5 text-sm font-semibold leading-6 shadow-sm hover:bg-opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cerise">SAVE</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- End of password update section -->
        
                <!-- Delete Account Card -->
                <div class="bg-red-200 w-full md:w-[55rem] shadow-xl rounded-xl mb-7 mt-8 md:mt-20">
                    <div class="w-full flex min-h-full flex-col justify-center px-0 py-6">            
                        <div class="mt-4 sm:mx-auto sm:w-full px-10">
                            <p class="text-xl mb-6">Permanently delete your account with all its data.</p>
                            <form class="space-y-6 mb-6" action="/delete_account" method="POST">
                                <div>
                                    <label for="password" class="block text-sm font-medium leading-6 text-gray-900">Enter your password</label>
                                    <div class="mt-2">
                                        <input id="password" name="password" type="password" value=""  required class="block w-full rounded-md border-0 py-1.5 pl-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-0 focus:outline-red-500 sm:text-sm sm:leading-6">
                                    </div>
                                </div>
                                
                                <div class="h-[0.004rem] w-full bg-black"></div>
                                <div class="mt-8 flex items-center justify-end">
                                    <button type="submit" class="mt-4 ml-4 flex w-fit justify-center rounded-md bg-red-600 px-8 py-1.5 text-sm font-semibold leading-6 shadow-sm hover:bg-opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cerise">DELETE</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- End of delete account card -->
        
            </div>
        </div>
    </div>
    <script src="/scripts/image-preview.js"></script>
    <%- include('components/footer')%>
</body>
</html>