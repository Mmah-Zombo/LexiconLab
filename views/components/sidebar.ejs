<!-- Burger -->
<div id="hamburger" class="bg-charcoal h-10 w-16 rounded-md md:hidden fixed top-3 left-4 z-20">
</div>

<!-- Sidebar -->
<div id="sidebar" class="hidden fixed bottom-0 top-0 z-30 w-80 h-full bg-charcoal md:flex flex-col items-center justify-between transition-all">
    <div id="cross" class="bg-antique-white h-10 w-16 rounded-md md:hidden fixed top-3 left-4 z-20">
    </div>
    <div class="w-full px-4 mt-8 h-fit">
        <div class="w-full flex flex-col items-center">
            <img src="<%= user.profile_photo %>" alt="" class="border-2 rounded-full w-32  h-32">
            <p class="mt-2 text-white font-bold text-lg"><%= user.username  %></p>
            <p class="text-white text-md opacity-60 -mt-1"><%= user.name %></p>
        </div>

        <div class="mt-6 w-full h-fit flex flex-col items-center justify-between">
            <a href="/dictionary" class="mt-1 w-full h-10 flex items-center justify-start border-b-2 border-cerise">
                <div class="h-fit w-fit mb-2">
                    <svg class="w-6 h-6 text-cerise dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M6 2a2 2 0 0 0-2 2v15a3 3 0 0 0 3 3h12a1 1 0 1 0 0-2h-2v-2h2a1 1 0 0 0 1-1V4a2 2 0 0 0-2-2h-8v16h5v2H7a1 1 0 1 1 0-2h1V2H6Z" clip-rule="evenodd"/>
                        </svg>
                        
                </div>
                <p class="ml-4 mb-2 text-lg text-white">Dictionary</p>
            </a>

            <a href="/dictionary" class="mt-5 w-full h-10 flex items-center justify-start border-b-2 border-cerise">
                <div class="h-fit w-fit mb-2 ">
                    <svg class="w-6 h-6 text-cerise dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M7.833 2c-.507 0-.98.216-1.318.576A1.92 1.92 0 0 0 6 3.89V21a1 1 0 0 0 1.625.78L12 18.28l4.375 3.5A1 1 0 0 0 18 21V3.889c0-.481-.178-.954-.515-1.313A1.808 1.808 0 0 0 16.167 2H7.833Z"/>
                        </svg>
                        
                </div>
                <p class="ml-4 mb-2 text-lg text-white">Bookmarks</p>
            </a>

            <a href="/dictionary" class="mt-5 w-full h-10 flex items-center justify-start border-b-2 border-cerise">
                <div class="w-fit h-fit mb-2">
                    <svg class="w-6 h-6 text-cerise dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/>
                        </svg>
                        
                </div>
                <p class="ml-4 mb-2 text-lg text-white">Search History</p>
            </a>

            <a href="#" class="mt-5 w-full h-10 flex items-center justify-start border-b-2 border-antique-white">
                <div class="h-fit w-fit mb-2">
                    <svg class="w-6 h-6 text-antique-white dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M17 10v1.126c.367.095.714.24 1.032.428l.796-.797 1.415 1.415-.797.796c.188.318.333.665.428 1.032H21v2h-1.126c-.095.367-.24.714-.428 1.032l.797.796-1.415 1.415-.796-.797a3.979 3.979 0 0 1-1.032.428V20h-2v-1.126a3.977 3.977 0 0 1-1.032-.428l-.796.797-1.415-1.415.797-.796A3.975 3.975 0 0 1 12.126 16H11v-2h1.126c.095-.367.24-.714.428-1.032l-.797-.796 1.415-1.415.796.797A3.977 3.977 0 0 1 15 11.126V10h2Zm.406 3.578.016.016c.354.358.574.85.578 1.392v.028a2 2 0 0 1-3.409 1.406l-.01-.012a2 2 0 0 1 2.826-2.83ZM5 8a4 4 0 1 1 7.938.703 7.029 7.029 0 0 0-3.235 3.235A4 4 0 0 1 5 8Zm4.29 5H7a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h6.101A6.979 6.979 0 0 1 9 15c0-.695.101-1.366.29-2Z" clip-rule="evenodd"/>
                        </svg>
                        
                </div>
                <p class="ml-4 mb-2 text-lg text-antique-white">User Settings</p>
            </a>
        </div>
    </div>

    <div class="w-full h-fit flex items-center justify-end border-t-2 border-cerise p-4">
        <div class="my-2 flex items-center justify-end">
            <form action="/logout" method="POST">
                <button type="submit" class="ml-4 flex w-fit justify-center rounded-md bg-cerise px-8 py-1.5 text-sm font-semibold leading-6 shadow-sm hover:bg-opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cerise">LOGOUT</button>
            </form>
        </div>
    </div>
</div>